---
// Looping hero animation: items drop into the grid, a cursor opens Pictures,
// and the view zooms through the folder into its contents.
// The whole timeline is CSS; the script only restarts it each cycle.
const items = [
  { name: 'Desktop', kind: 'folder' },
  { name: 'Documents', kind: 'folder' },
  { name: 'Downloads', kind: 'folder' },
  { name: 'Pictures', kind: 'folder', target: true },
  { name: 'Projects', kind: 'folder' },
  { name: 'Videos', kind: 'folder' },
  { name: '.profile', kind: 'file' },
  { name: 'README.md', kind: 'file' },
];
const photos = [
  { name: 'Sunrise.jpg', sky: ['#ffd9a8', '#fb9f86'], land: '#6d4f73', sun: '#fff4c9' },
  { name: 'Alps.jpg', sky: ['#9fd2ff', '#e4f2ff'], land: '#3f7d5b', sun: '#ffffff' },
  { name: 'Dusk.jpg', sky: ['#8487d9', '#e3a3d4'], land: '#3a3263', sun: '#ffe6f1' },
  { name: 'Lagoon.jpg', sky: ['#8be8c4', '#8ccff2'], land: '#2b6c6b', sun: '#f5fff9' },
  { name: 'Canyon.jpg', sky: ['#fcd688', '#f5847f'], land: '#8b4b3c', sun: '#fff5d6' },
  { name: 'Night.jpg', sky: ['#1f3b73', '#4d72a8'], land: '#142241', sun: '#f3efcf' },
  { name: 'Meadow.jpg', sky: ['#dafc85', '#98e3a3'], land: '#3f8c45', sun: '#ffffff' },
  { name: 'Harbor.jpg', sky: ['#8ff3fc', '#6ba8ff'], land: '#1e58a5', sun: '#ffffff' },
  { name: 'Bloom.jpg', sky: ['#fbc5ea', '#a9c2ee'], land: '#6c5a9d', sun: '#fff8fd' },
  { name: 'Desert.jpg', sky: ['#fddc95', '#d6fbff'], land: '#b98647', sun: '#fffbe6' },
];
const sidebar = ['Home', 'Desktop', 'Downloads', 'Documents', 'Pictures'];
---

<div
  class="fm"
  data-folder-motion
  role="img"
  aria-label="Animated preview of Chonky2: folders drop into the explorer, a cursor opens the Pictures folder, and the view zooms into its photos."
>
  <div class="fm-window" aria-hidden="true">
    <div class="fm-menubar">
      <span>Actions</span>
      <span>Options</span>
      <div class="fm-tools">
        <svg viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM12 10.5v5M9.5 13h5" /></svg>
        <svg viewBox="0 0 24 24"><path d="M12 15V4M7.5 8.5 12 4l4.5 4.5M5 15v4h14v-4" /></svg>
        <i></i>
        <svg viewBox="0 0 24 24"><path d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
        <svg class="is-active" viewBox="0 0 24 24"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" /></svg>
      </div>
    </div>

    <div class="fm-navbar">
      <svg viewBox="0 0 24 24"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
      <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      <svg viewBox="0 0 24 24"><path d="M12 19V5M6 11l6-6 6 6" /></svg>
      <div class="fm-path">
        <svg viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /></svg>
        <b>Home</b>
        <span class="fm-path-next"><span>›</span><b>Pictures</b></span>
      </div>
      <div class="fm-search">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.3-4.3" /></svg>
        Search
      </div>
    </div>

    <div class="fm-sidebar">
      <div class="fm-side-highlight"></div>
      <p>Files</p>
      {sidebar.map((name) => (
        <div class="fm-side-item">
          {name === 'Home'
            ? <svg viewBox="0 0 24 24"><path d="M4 10.5 12 4l8 6.5V20h-5v-6H9v6H4z" /></svg>
            : <span class="fm-mini"></span>}
          {name}
        </div>
      ))}
      <p>Workspace</p>
      <div class="fm-side-item"><span class="fm-mini"></span>Projects</div>
    </div>

    <div class="fm-content">
      <div class="fm-layer fm-home">
        {items.map((item, i) => (
          <div class:list={['fm-item', { 'is-target': item.target }]} style={`--i:${i};--col:${i % 4};--row:${Math.floor(i / 4)}`}>
            <span class="fm-item-bg"></span>
            <div class="fm-item-body">
              {item.kind === 'folder'
                ? <span class="fm-folder"><span class="fm-folder-back"></span><span class="fm-folder-paper"></span><span class="fm-folder-front"></span></span>
                : <span class="fm-file"></span>}
              <span class="fm-label">{item.name}</span>
            </div>
          </div>
        ))}
      </div>

      <div class="fm-layer fm-pictures">
        {photos.map((photo, i) => (
          <div
            class="fm-photo"
            style={`--i:${i};--col:${i % 5};--row:${Math.floor(i / 5)};--sky1:${photo.sky[0]};--sky2:${photo.sky[1]};--land:${photo.land};--sun:${photo.sun}`}
          >
            <span class="fm-thumb"></span>
            <span class="fm-label">{photo.name}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="fm-status">
      <span class="fm-count"><span class="fm-count-home">8 items</span><span class="fm-count-pictures">10 items</span></span>
      <span class="fm-selected">1 selected</span>
    </div>
  </div>

  <span class="fm-ripple" aria-hidden="true"></span>
  <svg class="fm-cursor" viewBox="0 0 16 22" aria-hidden="true"><path d="M1 1v16.5l4.3-4.1 2.9 6.8 2.8-1.2-2.9-6.6h6z" /></svg>
</div>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-folder-motion]').forEach((root) => {
    let visible = true;

    const restart = () => {
      root.classList.remove('is-playing');
      void root.offsetWidth;
      root.classList.add('is-playing');
    };

    const sync = () => {
      if (reducedMotion.matches) {
        root.classList.remove('is-playing', 'is-paused');
        return;
      }
      if (!root.classList.contains('is-playing')) restart();
      root.classList.toggle('is-paused', !visible);
    };

    // The root's own clock animation spans one full cycle.
    root.addEventListener('animationend', (event) => {
      if (event.target === root && !reducedMotion.matches) restart();
    });

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      sync();
    }).observe(root);

    reducedMotion.addEventListener('change', sync);
  });
</script>

<style>
  /* Geometry is in cqw so the scene scales with its width, like the screenshot it replaces.
     Target folder (Pictures, column 3, row 0) sits at 62.35cqw × 11.5cqw inside .fm-content. */
  .fm {
    --cycle: 9.6s;
    --origin: 62.35cqw 11.5cqw;
    --accent: #1f6fd1;
    position: relative;
    container-type: inline-size;
    aspect-ratio: 1840 / 1008;
    overflow: hidden;
    border-radius: 7px;
    background: radial-gradient(circle at 30% 20%, #eef2f6 0, transparent 60%), linear-gradient(160deg, #e3e9ef, #c3cfda);
    color: #1f2328;
    text-align: left;
    user-select: none;
  }
  .fm svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  .fm-window { position: absolute; inset: 2.1cqw 2.2cqw; overflow: hidden; border-radius: .9cqw; background: #fff; box-shadow: 0 1.2cqw 3cqw #1e324a2e, 0 0 0 1px #d5dde6; font-size: 1.2cqw; }

  .fm-menubar { display: flex; align-items: center; gap: 2cqw; height: 4.3cqw; padding: 0 1.9cqw; background: #f6f7f8; color: #2d333a; }
  .fm-tools { display: flex; align-items: center; gap: 1.2cqw; margin-left: auto; color: #3b434c; }
  .fm-tools svg { width: 2.4cqw; height: 2.4cqw; padding: .45cqw; border-radius: .45cqw; }
  .fm-tools svg.is-active { color: var(--accent); background: #e1ecf8; }
  .fm-tools i { width: 1px; height: 1.8cqw; background: #dde1e6; }

  .fm-navbar { display: flex; align-items: center; gap: 1.5cqw; height: 3.85cqw; padding: 0 1.1cqw .5cqw 1.6cqw; background: #f6f7f8; border-bottom: 1px solid #e6e8eb; color: #8a939d; }
  .fm-navbar > svg { width: 1.4cqw; height: 1.4cqw; }
  .fm-path { display: flex; flex: 1; align-items: center; gap: .6cqw; height: 2.75cqw; padding: 0 .8cqw; background: #fff; border: 1px solid #e1e4e8; border-radius: .45cqw; color: #1f2328; }
  .fm-path svg { width: 1.35cqw; height: 1.35cqw; color: #50585f; }
  .fm-path b { font-weight: 640; }
  .fm-path-next { display: flex; align-items: center; gap: .6cqw; opacity: 0; }
  .fm-path-next span { color: #8a939d; }
  .fm-search { display: flex; align-items: center; gap: .6cqw; width: 22.5cqw; height: 2.75cqw; margin-left: -1.5cqw; padding: 0 .8cqw; background: #fff; border: 1px solid #e1e4e8; border-left: 0; border-radius: 0 .45cqw .45cqw 0; color: #7d858e; }
  .fm-search svg { width: 1.3cqw; height: 1.3cqw; }

  .fm-sidebar { position: absolute; top: 8.15cqw; bottom: 2.4cqw; left: 0; width: 17.4cqw; padding: .7cqw .6cqw; border-right: 1px solid #e6e8eb; }
  .fm-sidebar p { display: flex; align-items: center; height: 2.3cqw; margin: 0; padding-left: .8cqw; color: #5d656e; font-size: 1.05cqw; font-weight: 640; }
  .fm-side-item { position: relative; display: flex; align-items: center; gap: .9cqw; height: 2.95cqw; padding-left: 1.3cqw; color: #1f2328; }
  .fm-side-item svg { width: 1.45cqw; height: 1.45cqw; }
  .fm-side-highlight { position: absolute; top: 3cqw; right: .6cqw; left: .6cqw; height: 2.95cqw; border-radius: .45cqw; background: #eceef1; }
  .fm-side-highlight::before { content: ''; position: absolute; top: .75cqw; bottom: .75cqw; left: 0; width: .22cqw; border-radius: 1cqw; background: var(--accent); }
  .fm-mini { width: 1.4cqw; height: 1.1cqw; border-radius: .2cqw; background: #f8b822; clip-path: polygon(0 0, 42% 0, 52% 16%, 100% 16%, 100% 100%, 0 100%); }

  .fm-content { position: absolute; top: 8.15cqw; right: 0; bottom: 2.4cqw; left: 17.4cqw; overflow: hidden; }
  .fm-layer { position: absolute; inset: 0; transform-origin: var(--origin); }
  .fm-pictures { opacity: 0; }

  .fm-item { position: absolute; top: calc(7.5cqw + var(--row) * 13.5cqw); left: calc(9.35cqw + var(--col) * 15.5cqw); width: 13cqw; height: 11.5cqw; }
  .fm-item-bg { position: absolute; inset: 0; border: 1px solid transparent; border-radius: .8cqw; background: #eef4fc; opacity: 0; }
  .fm-item-body { position: relative; display: flex; flex-direction: column; align-items: center; gap: 1cqw; height: 100%; padding-top: 1.2cqw; }
  .fm-label { max-width: 100%; overflow: hidden; color: #1f2328; text-overflow: ellipsis; white-space: nowrap; }

  .fm-folder { position: relative; width: 7.2cqw; height: 5.6cqw; }
  .fm-folder-back { position: absolute; inset: 0; border-radius: .5cqw; background: #eaa817; clip-path: polygon(0 0, 38% 0, 46% 14%, 100% 14%, 100% 100%, 0 100%); }
  .fm-folder-paper { position: absolute; top: 20%; right: 10%; left: 10%; height: 50%; border-radius: .3cqw; background: #fff; box-shadow: 0 0 0 1px #0000000f; }
  .fm-folder-front { position: absolute; top: 27%; right: 0; bottom: 0; left: 0; border-radius: .5cqw; background: linear-gradient(180deg, #ffd35c, #f8bb2a); box-shadow: inset 0 .15cqw 0 #ffe597, 0 .3cqw .8cqw #b37d1426; transform-origin: 50% 100%; }
  .fm-file {
    width: 4.4cqw;
    height: 5.6cqw;
    border-radius: .35cqw;
    background:
      linear-gradient(#b3bdc8, #b3bdc8) 50% 42% / 52% .18cqw no-repeat,
      linear-gradient(#b3bdc8, #b3bdc8) 50% 57% / 52% .18cqw no-repeat,
      linear-gradient(#b3bdc8, #b3bdc8) 36% 72% / 34% .18cqw no-repeat,
      #fff;
    box-shadow: inset 0 0 0 .12cqw #c9d1db;
  }

  .fm-photo { position: absolute; top: calc(8.3cqw + var(--row) * 12.5cqw); left: calc(5.1cqw + var(--col) * 14cqw); display: flex; flex-direction: column; align-items: center; gap: .7cqw; width: 12cqw; }
  .fm-photo .fm-label { font-size: 1.05cqw; }
  .fm-thumb { position: relative; width: 100%; height: 8.4cqw; overflow: hidden; border-radius: .6cqw; background: linear-gradient(170deg, var(--sky1), var(--sky2)); box-shadow: 0 .3cqw .9cqw #1c3d6a24; }
  .fm-thumb::before { content: ''; position: absolute; top: 16%; right: 18%; width: 2cqw; height: 2cqw; border-radius: 50%; background: var(--sun); opacity: .9; }
  .fm-thumb::after { content: ''; position: absolute; inset: 38% 0 0; background: var(--land); clip-path: polygon(0 100%, 0 55%, 22% 20%, 40% 52%, 62% 8%, 84% 45%, 100% 28%, 100% 100%); }
  .fm-photo:nth-child(3n + 2) .fm-thumb::after { clip-path: polygon(0 100%, 0 30%, 18% 50%, 38% 6%, 58% 46%, 76% 24%, 100% 60%, 100% 100%); }
  .fm-photo:nth-child(3n) .fm-thumb::after { clip-path: polygon(0 100%, 0 62%, 30% 34%, 48% 58%, 70% 16%, 100% 50%, 100% 100%); }

  .fm-status { position: absolute; right: 0; bottom: 0; left: 0; display: flex; align-items: center; gap: 1.5cqw; height: 2.4cqw; padding: 0 1.2cqw; border-top: 1px solid #e6e8eb; background: #f6f7f8; color: #5d656e; font-size: 1.05cqw; }
  .fm-count { display: grid; }
  .fm-count > span { grid-area: 1 / 1; }
  .fm-count-pictures, .fm-selected { opacity: 0; }
  .fm-selected { color: var(--accent); }

  .fm-ripple { position: absolute; top: 22.5cqw; left: 82.5cqw; width: 5cqw; height: 5cqw; margin: -2.5cqw 0 0 -2.5cqw; border: .22cqw solid var(--accent); border-radius: 50%; opacity: 0; pointer-events: none; }
  .fm-cursor { position: absolute; top: 0; left: 0; z-index: 2; width: 2cqw; height: 2.75cqw; opacity: 0; transform-origin: 6% 5%; filter: drop-shadow(0 .2cqw .35cqw #0000004d); }
  .fm .fm-cursor { fill: #16191d; stroke: #fff; stroke-width: 1.3; }

  /* ---- Timeline (one cycle = 9.6s; percentages below are of the cycle) ---- */
  .fm.is-playing { animation: fm-clock var(--cycle) linear both; }
  .fm.is-paused, .fm.is-paused * { animation-play-state: paused !important; }

  /* 0.25s–1.4s: items drop into their slots */
  .fm.is-playing .fm-item { animation: fm-drop .7s cubic-bezier(.34, 1.4, .55, 1) calc(.25s + var(--i) * .08s) both; }
  /* 1.5s–3.4s: cursor travels to Pictures, hovers, clicks */
  .fm.is-playing .fm-cursor { animation: fm-cursor var(--cycle) linear both; }
  .fm.is-playing .is-target .fm-item-bg { animation: fm-hover var(--cycle) linear both; }
  .fm.is-playing .fm-ripple { animation: fm-ripple .65s ease-out 3.2s both; }
  .fm.is-playing .fm-selected { animation: fm-selected var(--cycle) linear both; }
  /* 3.25s: folder opens, the rest dim */
  .fm.is-playing .fm-item:not(.is-target) .fm-item-body { animation: fm-dim .35s ease 3.25s both; }
  .fm.is-playing .is-target .fm-folder { animation: fm-pop .5s cubic-bezier(.3, 1.6, .5, 1) 3.25s both; }
  .fm.is-playing .is-target .fm-folder-front { animation: fm-flap .45s ease-out 3.3s both; }
  .fm.is-playing .is-target .fm-folder-paper { animation: fm-paper .45s ease-out 3.3s both; }
  /* 3.55s–4.7s: zoom through the folder into Pictures */
  .fm.is-playing .fm-home { animation: fm-zoom-out .95s cubic-bezier(.6, 0, .3, 1) 3.55s both; }
  .fm.is-playing .fm-pictures { animation: fm-zoom-in var(--cycle) linear both; }
  .fm.is-playing .fm-photo { animation: fm-rise .55s cubic-bezier(.2, .8, .2, 1) calc(4.2s + var(--i) * .055s) both; }
  .fm.is-playing .fm-side-highlight { animation: fm-side var(--cycle) linear both; }
  .fm.is-playing .fm-path-next { animation: fm-crumb var(--cycle) linear both; }
  .fm.is-playing .fm-count-home { animation: fm-count-home var(--cycle) linear both; }
  .fm.is-playing .fm-count-pictures { animation: fm-count-pictures var(--cycle) linear both; }
  /* 8.8s–9.4s: Pictures fades out, then the cycle restarts */

  @keyframes fm-clock { from, to { visibility: visible; } }

  @keyframes fm-drop {
    from { opacity: 0; translate: 0 -6cqw; }
    50% { opacity: 1; }
    to { opacity: 1; translate: 0 0; }
  }

  @keyframes fm-cursor {
    0%, 15.6% { opacity: 0; translate: 58cqw 60cqw; scale: 1; animation-timing-function: cubic-bezier(.45, 0, .2, 1); }
    18.8% { opacity: 1; }
    30.2% { translate: 82.5cqw 22.5cqw; }
    32.3% { scale: 1; animation-timing-function: ease-in; }
    33.3% { scale: .8; animation-timing-function: ease-out; }
    35.4% { scale: 1; }
    37.5% { opacity: 1; }
    40.1%, 100% { opacity: 0; translate: 82.5cqw 22.5cqw; scale: 1; }
  }

  @keyframes fm-hover {
    0%, 28.6% { opacity: 0; }
    30.7% { opacity: 1; }
    32.3% { border-color: transparent; background: #eef4fc; }
    33.3%, 100% { opacity: 1; border-color: #b8d1f0; background: #dbe8f8; }
  }

  @keyframes fm-ripple {
    0% { opacity: 0; scale: .2; }
    1% { opacity: .55; }
    100% { opacity: 0; scale: 1.5; }
  }

  @keyframes fm-selected {
    0%, 33.3% { opacity: 0; }
    34.4%, 40.6% { opacity: 1; }
    42.7%, 100% { opacity: 0; }
  }

  @keyframes fm-dim { to { opacity: .3; } }
  @keyframes fm-pop { to { scale: 1.14; } }
  @keyframes fm-flap {
    from { transform: perspective(20cqw) rotateX(0); }
    to { transform: perspective(20cqw) rotateX(-35deg); }
  }
  @keyframes fm-paper { to { translate: 0 -22%; } }

  @keyframes fm-zoom-out {
    from { opacity: 1; scale: 1; filter: blur(0); }
    45% { opacity: 1; }
    to { opacity: 0; scale: 3.6; filter: blur(.25cqw); }
  }

  @keyframes fm-zoom-in {
    0%, 39.6% { opacity: 0; scale: .35; animation-timing-function: cubic-bezier(.16, .84, .3, 1); }
    49% { opacity: 1; scale: 1; }
    91.7% { opacity: 1; scale: 1; animation-timing-function: cubic-bezier(.5, 0, .75, 0); }
    97.9%, 100% { opacity: 0; scale: .96; }
  }

  @keyframes fm-rise {
    from { opacity: 0; translate: 0 1.4cqw; scale: .96; }
    to { opacity: 1; translate: 0 0; scale: 1; }
  }

  @keyframes fm-side {
    0%, 41.7% { translate: 0 0; animation-timing-function: cubic-bezier(.3, .7, .2, 1); }
    46.9% { translate: 0 11.8cqw; }
    91.7% { translate: 0 11.8cqw; animation-timing-function: cubic-bezier(.3, .7, .2, 1); }
    96.9%, 100% { translate: 0 0; }
  }

  @keyframes fm-crumb {
    0%, 41.7% { opacity: 0; translate: -.8cqw 0; animation-timing-function: ease-out; }
    45.8% { opacity: 1; translate: 0 0; }
    91.7% { opacity: 1; translate: 0 0; animation-timing-function: ease-in; }
    95.8%, 100% { opacity: 0; translate: -.8cqw 0; }
  }

  @keyframes fm-count-home {
    0%, 40.6% { opacity: 1; }
    42.7%, 95.8% { opacity: 0; }
    97.9%, 100% { opacity: 1; }
  }

  @keyframes fm-count-pictures {
    0%, 41.7% { opacity: 0; }
    43.8%, 93.8% { opacity: 1; }
    95.8%, 100% { opacity: 0; }
  }
</style>
