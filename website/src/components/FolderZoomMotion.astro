  .fm-remove .fm-lucide { width: calc(13 * var(--u)); height: calc(13 * var(--u)); stroke-width: 2; }

  /* File list (chonky.css: grid view) */
  .fm-content { position: absolute; top: 8.15cqw; right: 0; bottom: 2.4cqw; left: 17.4cqw; overflow: hidden; }
  .fm-layer { position: absolute; inset: 0; transform-origin: var(--origin); }
  .fm-pictures { opacity: 0; }

  .fm-item { position: absolute; top: calc((6 + var(--row) * 148) * var(--u)); left: calc((8 + var(--col) * 148.5) * var(--u)); width: calc(140.5 * var(--u)); height: calc(140 * var(--u)); }
  .fm-item.is-launch-target { z-index: 2; }
  .fm-entry { display: flex; flex-direction: column; align-items: center; gap: calc(4 * var(--u)); height: 100%; padding: calc(8 * var(--u)) calc(6 * var(--u)) calc(6 * var(--u)); border-radius: calc(6 * var(--u)); }
  .fm-preview { position: relative; display: flex; flex: 1; align-items: center; justify-content: center; width: 100%; min-height: 0; }
  .fm-preview > .fm-glyph { width: calc(64 * var(--u)); height: calc(64 * var(--u)); }
  .fm-name { display: -webkit-box; max-width: 100%; overflow: hidden; font-size: calc(13 * var(--u)); line-height: 1.35; text-align: center; word-break: break-word; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .fm-ext { color: #616161; }

  .fm-glyph { overflow: visible; }
  .fm-folder-paper { opacity: 0; }
  .fm-folder-front { transform-box: fill-box; transform-origin: 50% 100%; }
  .fm-file-paper { fill: #fff; stroke: #c4c4c4; stroke-width: 1; }
  .fm-file-fold { fill: #e9e9e9; stroke: #c4c4c4; stroke-width: 1; stroke-linejoin: round; }

  .fm-thumb { position: relative; width: 100%; aspect-ratio: 4 / 3; max-height: 100%; overflow: hidden; border-radius: calc(4 * var(--u)); background: linear-gradient(170deg, var(--sky1), var(--sky2)); }
  .fm-thumb::before { content: ''; position: absolute; top: 16%; right: 18%; width: 18%; aspect-ratio: 1; border-radius: 50%; background: var(--sun); opacity: .9; }
  .fm-thumb::after { content: ''; position: absolute; inset: 38% 0 0; background: var(--land); clip-path: polygon(0 100%, 0 55%, 22% 20%, 40% 52%, 62% 8%, 84% 45%, 100% 28%, 100% 100%); }
  .fm-photo:nth-child(3n + 2) .fm-thumb::after { clip-path: polygon(0 100%, 0 30%, 18% 50%, 38% 6%, 58% 46%, 76% 24%, 100% 60%, 100% 100%); }
  .fm-photo:nth-child(3n) .fm-thumb::after { clip-path: polygon(0 100%, 0 62%, 30% 34%, 48% 58%, 70% 16%, 100% 50%, 100% 100%); }
  .fm-launch { position: absolute; inset: 0; margin: auto; opacity: 0; box-shadow: 0 calc(6 * var(--u)) calc(18 * var(--u)) #00000040; }

  .fm-status { position: absolute; right: 0; bottom: 0; left: 0; display: flex; align-items: center; gap: 1.5cqw; height: 2.4cqw; padding: 0 1.2cqw; border-top: 1px solid #e6e8eb; background: #f6f7f8; color: #5d656e; font-size: 1.05cqw; }
