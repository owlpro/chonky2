  .fm-search svg { width: 1.3cqw; height: 1.3cqw; }

  /* Sidebar (chonky.css: .chonky-sidebar*) */
  .fm-sidebar { position: absolute; top: 8.15cqw; bottom: 2.4cqw; left: 0; width: 17.4cqw; border-right: 1px solid #ececec; }
  .fm-side-rows, .fm-sec-group, .fm-recent, .fm-recent-old { position: absolute; inset: 0; }
  .fm-fav-zone { position: absolute; top: calc(6 * var(--u)); right: 0; left: 0; height: calc(99 * var(--u)); background: rgba(0, 120, 212, .14); box-shadow: inset 0 0 0 1px var(--accent); opacity: 0; }

  .fm-section, .fm-side-item { position: absolute; top: calc(var(--top) * var(--u)); right: calc(6 * var(--u)); left: calc(6 * var(--u)); display: flex; align-items: center; border-radius: calc(4 * var(--u)); }
  .fm-section { gap: calc(4 * var(--u)); height: calc(26 * var(--u)); padding-right: calc(8 * var(--u)); color: #616161; font-size: calc(12 * var(--u)); font-weight: 600; }
  .fm-section .fm-lucide { width: calc(14 * var(--u)); height: calc(14 * var(--u)); margin-right: calc(2 * var(--u)); stroke-width: 2; }
