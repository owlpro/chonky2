---
import '../styles/global.css';
import '../styles/home.css';
import FolderZoomMotion from '../components/FolderZoomMotion.astro';
import ResponsiveDemo from '../components/ResponsiveDemo';
import { buttonVariants } from '../components/ui/button';

const githubUrl = 'https://github.com/owlpro/chonky2';
const npmUrl = 'https://www.npmjs.com/package/chonky2';
const siteUrl = 'https://chonky2.mdpro-smm.workers.dev';
const features = [
  { number: '01', icon: '▤', title: 'Built for browsing', description: 'Move between folders with breadcrumbs, Back and Forward, a sidebar, and search. Switch between sortable list and thumbnail grid views.' },
  { number: '02', icon: '⌘', title: 'Every action in reach', description: 'Give people selection, keyboard shortcuts, context menus, drag and drop, and opt-in actions for rename, upload, copy, and more.' },
  { number: '03', icon: '◐', title: 'Make it yours', description: 'Use the built-in light and dark themes, CSS variables, custom icons, translations, and your own actions or toolbar content.' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f9fc" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="description" content="Chonky2 is a file explorer component for React with list and grid views, navigation, drag and drop, and custom file actions." />
    <link rel="canonical" href={siteUrl + "/"} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl + "/"} />
    <meta property="og:title" content="Chonky2 — A file explorer for React" />
    <meta property="og:description" content="A flexible file explorer for React apps. Connect it to your own backend." />
    <meta property="og:image" content={siteUrl + "/images/explorer-demo.webp"} />
    <title>React File Explorer Component | Chonky2</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="container nav-wrap">
          <a class="brand" href="/" aria-label="Chonky2 home">
            <span class="brand-mark" aria-hidden="true"><span></span></span>
            <span>chonky<span class="brand-accent">2</span></span>
          </a>
          <nav class="desktop-nav" aria-label="Primary navigation">
            <a href="#features">Features</a>
            <a href="#demo">Live demo</a>
            <a href="/docs/">Documentation</a>
            <a href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          </nav>
          <a class={buttonVariants({ size: 'sm' }) + ' nav-cta'} href="/docs/">Get started <span aria-hidden="true">↗</span></a>
          <details class="mobile-nav">
            <summary aria-label="Open navigation"><span></span><span></span><span></span></summary>
            <nav aria-label="Mobile navigation">
              <a href="#features">Features</a>
              <a href="#demo">Preview</a>
              <a href="/docs/">Documentation</a>
              <a href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            </nav>
          </details>
        </div>
      </header>

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-glow" aria-hidden="true"></div>
          <div class="container hero-content">
            <div class="hero-copy">
              <a class="version-pill" href={githubUrl} target="_blank" rel="noopener noreferrer">
                <span class="version-dot"></span> Explore Chonky2 v7 <span aria-hidden="true">↗</span>
              </a>
              <h1 id="hero-title">Your files deserve a <span>better view.</span></h1>
              <p class="hero-lead">A file explorer for React apps. Add familiar desktop-style browsing to your product, then connect it to your own data and actions.</p>
              <div class="hero-actions">
                <a class={buttonVariants({ size: 'lg' }) + ' button-primary'} href="/docs/">Get started <span aria-hidden="true">↗</span></a>
                <a class={buttonVariants({ variant: 'outline', size: 'lg' }) + ' button-secondary'} href="#demo">Explore the preview <span aria-hidden="true">↓</span></a>
              </div>
              <div class="hero-meta" aria-label="Package highlights">
                <span><i aria-hidden="true"></i> React 19+</span>
                <span><i aria-hidden="true"></i> TypeScript included</span>
                <span><i aria-hidden="true"></i> Any backend</span>
              </div>
            </div>
            <div class="hero-visual">
              <div class="preview-caption">
                <span class="window-symbol" aria-hidden="true">◫</span>
                <span>File explorer / Home</span>
                <span class="preview-caption-right">LIGHT MODE <span class="caption-spark" aria-hidden="true">✦</span></span>
              </div>
              <FolderZoomMotion />
            </div>
            <div class="hero-caption"><span class="caption-line"></span> A preview of the Chonky2 experience</div>
          </div>
        </section>

        <section class="bundle-section" aria-labelledby="bundle-title">
          <div class="container bundle-inner">
            <div class="bundle-intro">
              <p class="section-kicker"><span class="kicker-line"></span> SMALL BUNDLE, FULL EXPLORER</p>
              <h2 id="bundle-title">Everything you need. <em>Less to ship.</em></h2>
            </div>
            <div class="bundle-grid">
              <div class="bundle-stat bundle-stat-size">
                <strong>~64 <span>KB</span></strong>
                <p>Full explorer, minified + Brotli, with its dependencies included.</p>
              </div>
              <div class="bundle-stat">
                <strong>Less than half</strong>
                <p>the bundle cost of original Chonky's ~139 KB baseline.</p>
              </div>
              <div class="bundle-stat">
                <strong>No UI framework</strong>
                <p>No MUI, Emotion or styled-components. Only React and React DOM are peer dependencies.</p>
              </div>
            </div>
            <p class="bundle-note">Measured with yarn size on the current v7 build. The estimate includes Redux, React DnD, list virtualization, and icons. Apps already using shared dependencies may see a lower incremental cost.</p>
          </div>
        </section>

        <section class="use-cases" aria-label="Where Chonky2 fits">
          <div class="container use-cases-inner">
            <span class="section-kicker">ONE COMPONENT, MANY PRODUCTS</span>
            <div class="use-case-list">
              <span>Cloud drives</span><span class="use-case-separator">✳</span>
              <span>Media libraries</span><span class="use-case-separator">✳</span>
              <span>CMS asset pickers</span><span class="use-case-separator">✳</span>
              <span>Document portals</span>
            </div>
          </div>
        </section>

        <section class="features-section section-space" id="features" aria-labelledby="features-title">
          <div class="container">
            <div class="section-heading">
              <div>
                <p class="section-kicker"><span class="kicker-line"></span> THE TOOLKIT</p>
                <h2 id="features-title">All the details that make<br /><em>files feel familiar.</em></h2>
              </div>
              <p>Give users the file management experience they already know, without building every interaction from scratch.</p>
            </div>
            <div class="feature-grid">
              {features.map((feature) => (
                <article class="feature-card">
                  <div class="feature-card-top"><span class="feature-icon" aria-hidden="true">{feature.icon}</span><span class="feature-number">{feature.number} / 03</span></div>
                  <div><h3>{feature.title}</h3><p>{feature.description}</p></div>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section class="showcase-section section-space" aria-labelledby="showcase-title">
          <div class="container showcase-grid">
            <div class="showcase-copy">
              <p class="section-kicker"><span class="kicker-line"></span> YOUR UI, YOUR RULES</p>
              <h2 id="showcase-title">Looks at home,<br /><em>wherever it lives.</em></h2>
              <p class="showcase-lead">A flexible interface with light and dark modes, file thumbnails, a sidebar, and CSS variables for your own colors.</p>
              <ul class="check-list">
                <li><span aria-hidden="true">✓</span> List and grid views</li>
                <li><span aria-hidden="true">✓</span> Built-in light and dark themes</li>
                <li><span aria-hidden="true">✓</span> Extendable layout and actions</li>
              </ul>
              <a class="text-link" href={githubUrl + '#theming'} target="_blank" rel="noopener noreferrer">See theming options <span aria-hidden="true">↗</span></a>
            </div>
            <div class="showcase-visual">
              <div class="showcase-orbit" aria-hidden="true"></div>
              <div class="dark-shot">
                <div class="dark-shot-bar"><span>◐</span> Pictures / Grid view <span>● ● ●</span></div>
                <img src="/images/explorer-dark.webp" width="1840" height="1008" loading="lazy" alt="Chonky2 dark mode with a picture grid and thumbnails" />
              </div>
              <span class="showcase-tag">DARK MODE / GRID VIEW</span>
            </div>
          </div>
        </section>

        <section class="demo-section section-space" id="demo" aria-labelledby="demo-title">
          <div class="container">
            <div class="section-heading demo-heading">
              <div>
                <p class="section-kicker"><span class="kicker-line"></span> <span class="demo-desktop-only">TRY IT YOURSELF</span><span class="demo-mobile-only">PRODUCT PREVIEW</span></p>
                <h2 id="demo-title"><span class="demo-desktop-only">Go ahead. <em>Click around.</em></span><span class="demo-mobile-only">Explore the <em>interface.</em></span></h2>
              </div>
              <p><span class="demo-desktop-only">Open folders, switch views, search, select files, or toggle the theme. This sample runs entirely in your browser.</span><span class="demo-mobile-only">See the current Chonky2 interface below. The interactive sample is available on wider screens.</span></p>
            </div>
            <div class="demo-frame"><ResponsiveDemo client:only="react" /></div>
            <div class="demo-mobile-card">
              <div class="demo-mobile-top"><span><i aria-hidden="true"></i> Chonky2 preview</span><span>VERSION 7</span></div>
              <div class="demo-mobile-image"><img src="/images/explorer-demo.webp" width="1200" height="630" loading="lazy" alt="Chonky2 file explorer with Favorites and Recent lists and a collapsed Folders section" /></div>
              <div class="demo-mobile-content">
                <h3>Ready for your files.</h3>
                <p>Bring this explorer into a React app and connect it to your own storage.</p>
                <a href="/docs/first-explorer/">Build your first explorer <span aria-hidden="true">↗</span></a>
              </div>
            </div>
            <p class="demo-note">The demo uses sample data in memory. Connect Chonky2 to your API to load and manage real files.</p>
          </div>
        </section>

        <section class="integration-section section-space" aria-labelledby="integration-title">
          <div class="container integration-grid">
            <div>
              <p class="section-kicker"><span class="kicker-line"></span> IN YOUR APP</p>
              <h2 id="integration-title">Bring the files.<br /><em>We'll bring the explorer.</em></h2>
              <p class="integration-lead">Pass your files and current folder to Chonky2. Listen for actions such as opening a folder, then update the data from your API. Storage stays in your control.</p>
              <a class={buttonVariants({ size: 'lg' }) + ' button-primary'} href="/docs/">Read the documentation <span aria-hidden="true">↗</span></a>
            </div>
            <div class="code-window">
              <div class="code-title"><span class="code-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>Explorer.tsx</span><span>TSX</span></div>
              <pre aria-label="React code example"><code><span class="code-purple">import</span> {'{'} FullFileBrowser {'}'} <span class="code-purple">from</span> <span class="code-green">'chonky2'</span>;

<span class="code-purple">export default function</span> <span class="code-blue">Explorer</span>() {'{'}
  <span class="code-purple">return</span> (
    &lt;<span class="code-blue">div</span> <span class="code-orange">style</span>={'{'}{'{'} height: <span class="code-orange">500</span> {'}'}{'}'}&gt;
      &lt;<span class="code-blue">FullFileBrowser</span>
        <span class="code-orange">files</span>={'{'}files{'}'}
        <span class="code-orange">folderChain</span>={'{'}folderChain{'}'}
        <span class="code-orange">onFileAction</span>={'{'}handleAction{'}'}
      /&gt;
    &lt;/<span class="code-blue">div</span>&gt;
  );
{'}'}</code></pre>
              <div class="install-bar"><span><span aria-hidden="true">$</span> npm install chonky2</span><button type="button" id="copy-install" aria-label="Copy npm install command">Copy</button></div>
            </div>
          </div>
        </section>

        <section class="closing-section">
          <div class="container closing-inner">
            <div class="closing-decoration" aria-hidden="true">✳</div>
            <p class="section-kicker">READY TO BUILD?</p>
            <h2>Give your files<br /><em>a place to belong.</em></h2>
            <p>Start with the package, explore the API, and make the experience your own.</p>
            <div class="closing-actions">
              <a class={buttonVariants({ size: 'lg' }) + ' closing-button'} href="/docs/">Get started <span aria-hidden="true">↗</span></a>
              <a class="closing-github" href={githubUrl} target="_blank" rel="noopener noreferrer">View on GitHub <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </section>
      </main>

      <footer class="site-footer">
        <div class="container footer-inner">
          <a class="brand" href="/" aria-label="Chonky2 home">
            <span class="brand-mark" aria-hidden="true"><span></span></span>
            <span>chonky<span class="brand-accent">2</span></span>
          </a>
          <p>A file explorer for React. Inspired by familiar desktop workflows.</p>
          <nav aria-label="Footer navigation">
            <a href="/docs/">Docs</a>
            <a href={npmUrl} target="_blank" rel="noopener noreferrer">npm ↗</a>
            <a href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          </nav>
        </div>
      </footer>
    </div>
    <script>
      document.getElementById('copy-install')?.addEventListener('click', async (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        try {
          await navigator.clipboard.writeText('npm install chonky2');
          button.textContent = 'Copied!';
          window.setTimeout(() => { button.textContent = 'Copy'; }, 1800);
        } catch {
          button.textContent = 'Select command to copy';
        }
      });
    </script>
  </body>
</html>
