{
    "name": "chonky2",
    "version": "7.4.2",
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.es.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.es.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "description": "A file explorer component for React with list and grid views, a sidebar, drag and drop, copy and paste, rename, and keyboard shortcuts. Works with any backend.",
    "license": "MIT",
    "engines": {
        "node": ">=18"
    },
    "workspaces": [
        "website"
    ],
    "scripts": {
        "dev": "vite --config playground/vite.config.ts",
        "build": "vite build",
        "site:dev": "yarn build && yarn workspace @chonky2/website dev",
        "site:build": "yarn build && yarn workspace @chonky2/website build",
        "site:check": "yarn build && yarn workspace @chonky2/website check",
        "watch": "vite build --watch",
        "watch:linked": "vite build --watch --mode linked",
        "size": "size-limit"
    },
    "size-limit": [
        {
            "path": "dist/index.es.js",
            "limit": "68 kB"
        }
    ],
    "dependencies": {
        "@reduxjs/toolkit": "^2.9.0",
        "hotkeys-js": "^3.13.4",
        "lucide-react": "^0.545.0",
        "react-dnd": "^16.0.1",
        "react-dnd-html5-backend": "^16.0.1",
        "react-redux": "^9.1.2",
        "react-window": "^1.8.11"
    },
    "devDependencies": {
        "@size-limit/preset-small-lib": "^11.2.0",
        "@testing-library/react": "^16.0.1",
        "@types/node": "^24.7.2",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@types/react-window": "^1.8.8",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "size-limit": "^11.2.0",
        "typescript": "^5.9.3",
        "vite": "^6.3.6",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "^3.2.4",
        "wrangler": "^4.145.0"
    },
    "peerDependencies": {
        "react": ">=19",
        "react-dom": ">=19"
    },
    "homepage": "https://chonky2.mdpro-smm.workers.dev/",
    "author": {
        "name": "Mahdi Amiri",
        "email": "mdpro.smm@gmail.com",
        "url": "https://github.com/owlpro"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/owlpro/chonky2.git"
    },
    "bugs": {
        "url": "https://github.com/owlpro/chonky2/issues"
    },
    "keywords": [
        "react",
        "react-component",
        "file-browser",
        "file-explorer",
        "file-manager",
        "file-picker",
        "file-dialog",
        "media-library",
        "drag-and-drop",
        "chonky",
        "chonky2"
    ],
    "packageManager": "yarn@4.10.3"
}
